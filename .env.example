# OmniBey & OmniMail Environment Configuration
# Main Domain: omnibey.com
# Mail Service: mail.omnibey.com

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OmniBey
NEXT_PUBLIC_PRODUCT_NAME="OmniMail — Temporary Email by OmniBey"

# Available Temporary Mail Domains (comma-separated)
NEXT_PUBLIC_DEFAULT_MAIL_DOMAIN=mail.omnibey.com
NEXT_PUBLIC_AVAILABLE_DOMAINS=mail.omnibey.com,omnibey.com,omnimail.app

# Supabase (PostgreSQL, Auth, Storage, RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage Bucket for attachments & raw EML files
SUPABASE_STORAGE_BUCKET=omnimail-attachments

# Ingestion Webhook Security (Cloudflare Email Worker or external Mail Router)
INGESTION_WEBHOOK_SECRET=omnimail_prod_sec_replace_with_strong_random_token

# Mailbox Lifecycle Defaults
DEFAULT_MAILBOX_EXPIRY_MINUTES=60
MAX_ATTACHMENT_SIZE_MB=25

# Google OAuth Credentials (Optional / Supabase Auth provider)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Telegram Bot Admin Alerts (Section 17)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# Storage Bucket for payment proof screenshots (Section 15 & 38)
SUPABASE_PAYMENT_PROOF_BUCKET=payment-proof

# Future Provider Extensibility toggles
ENABLE_CLOUDFLARE_ROUTING=true
ENABLE_GMAIL_INTEGRATION=false
ENABLE_OUTLOOK_INTEGRATION=false
ENABLE_AI_SUMMARY=false
